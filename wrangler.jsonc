{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qtb-dev-tools",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference service binding required by @opennextjs/cloudflare
      // (cache population / revalidation). The name must match the worker name.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "qtb-dev-tools"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qtb-db",
      "database_id": "6bab3e4d-7447-489f-905f-408659c434ca"
    }
  ],
  "observability": {
    "enabled": true
  }
}
